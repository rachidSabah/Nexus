{
  "name": "@anx/persistence",
  "version": "0.5.0",
  "description": "Persistence adapters — PostgreSQL, SQLite, Redis via repository pattern",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
