{
  "name": "@agent-nexus/quality-engine",
  "version": "0.5.0",
  "description": "Engineering Excellence Suite - Compatibility Certification, Performance Benchmarking, Chaos Engineering",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anx/core": "workspace:*",
    "@anx/integrations": "workspace:*",
    "@anx/routing": "workspace:*",
    "@anx/observability": "workspace:*",
    "@anx/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "tsup": "^8.3.5",
    "vitest": "^4.1.10",
    "eslint": "^10.8.1",
    "rimraf": "^6.0.1"
  },
  "keywords": [
    "quality",
    "testing",
    "benchmark",
    "chaos-engineering",
    "certification",
    "agent-nexus"
  ],
  "author": "Agent Nexus Team",
  "license": "MIT",
  "homepage": "https://github.com/rachidSabah/Nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachidSabah/Nexus.git"
  },
  "bugs": {
    "url": "https://github.com/rachidSabah/Nexus/issues"
  }
}
