{
  "name": "@anx/integrations",
  "version": "0.5.0",
  "description": "Native integrations: auto-configure AI tools (Claude Code, Cursor, OpenCode, …) to use Agent Nexus Gateway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@anx/core": "workspace:*",
    "@anx/shared": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@vitest/coverage-v8": "^3.2.6"
  }
}
