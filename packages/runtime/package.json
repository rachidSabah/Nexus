{
  "name": "@anx/runtime",
  "version": "0.5.0",
  "description": "Agent Runtime — lifecycle, sessions, streaming, retry/timeout for executing agent tasks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@anx/core": "workspace:*",
    "@anx/agents": "workspace:*",
    "@anx/security": "workspace:*",
    "@anx/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10"
  }
}
