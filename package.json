{
  "name": "agent-nexus-gateway",
  "version": "0.5.0",
  "private": true,
  "description": "Universal AI Coding-Agent Gateway & Autonomous Control Plane — dynamic multi-provider routing, protocol translation, token optimization, and self-healing agent mesh.",
  "keywords": [
    "ai-agent",
    "agentic-ai",
    "coding-agent",
    "ai-gateway",
    "llm-gateway",
    "claude-code",
    "codex",
    "google-antigravity",
    "antigravity-cli",
    "deepseek",
    "gemini-3",
    "model-context-protocol",
    "mcp",
    "mcp-server",
    "multi-agent",
    "agent-mesh",
    "token-optimization",
    "prompt-compression",
    "developer-tools",
    "pair-programming"
  ],
  "license": "Apache-2.0",
  "author": "Agent Nexus Gateway Contributors",
  "homepage": "https://github.com/rachidSabah/Nexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/rachidSabah/Nexus.git"
  },
  "bugs": {
    "url": "https://github.com/rachidSabah/Nexus/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anx/cli": "workspace:*",
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "6.4.3",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "nanoid": "3.3.18"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
