{
  "name": "@anx/builder",
  "version": "0.5.0",
  "description": "Universal Build & Pipeline Execution Engine for Agent Nexus (Hexagonal / Clean Architecture)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "@fastify/cors": "^11.3.1",
    "zod": "^4.6.7",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
