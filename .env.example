# Agent Nexus Gateway — environment variables
# Copy to .env and fill in your values.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8787
NEXUS_PORT=8787
NEXUS_HOST=127.0.0.1
NEXUS_BASE_URL=http://127.0.0.1:8787
NODE_ENV=production
ANX_CONFIG=                          # path to config file (optional)

# ─── Routing & Agents ───────────────────────────────────────────────────────
NEXUS_TARGET_MODEL=nexus/best-coding # Default routing target
NEXUS_ROUTING_POLICY=best-coding     # Default policy (free, fast, cheap, best, best-coding)
AGY_WORKSPACE_ROOT=                  # Custom workspace root for AGY applications (optional)

# ─── Provider API keys ──────────────────────────────────────────────────────
# Set only the ones you want to use. The gateway auto-discovers these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
AZURE_OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=

# ─── Security ───────────────────────────────────────────────────────────────
# Master key for the encrypted credential vault. Generate with: openssl rand -hex 32
AGENT_NEXUS_VAULT_KEY=
# JWT signing secret. Generate with: openssl rand -hex 32
ANX_JWT_SECRET=
# Admin API key (used by the dashboard)
ANX_ADMIN_API_KEY=

# ─── Networking ─────────────────────────────────────────────────────────────
# HTTP/HTTPS/SOCKS5 proxy for outbound requests (undici ProxyAgent)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ─── Dashboard ──────────────────────────────────────────────────────────────
# URL of the gateway, as seen by the dashboard
NEXUS_GATEWAY_URL=http://localhost:8787

# ─── Observability ──────────────────────────────────────────────────────────
# OpenTelemetry exporter (planned)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-nexus-gateway

# ─── Development ────────────────────────────────────────────────────────────
LOG_LEVEL=info
